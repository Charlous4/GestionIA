{% extends 'base.html.twig' %}
{% block title %}{{ editeur.nom }}{% endblock %}

{% block body %}

{% set colors = ['#6c63ff', '#38bdf8', '#10b981', '#f59e0b', '#ec4899', '#a09aff'] %}
{% set c = colors[editeur.id % 6] %}

<div class="pg-header anim">
    <div style="display:flex;align-items:center;gap:12px">
        <a href="{{ path('app_editeur_index') }}"
           style="width:34px;height:34px;border-radius:var(--r8);background:var(--bg-2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--t2);text-decoration:none;transition:color .15s"
           onmouseover="this.style.color='var(--t1)'" onmouseout="this.style.color='var(--t2)'">
            <i class="ti ti-arrow-left" style="font-size:15px"></i>
        </a>
        <div style="width:44px;height:44px;border-radius:var(--r12);background:{{ c }}22;border:1px solid {{ c }}40;display:flex;align-items:center;justify-content:center">
            <i class="ti ti-building-skyscraper" style="font-size:20px;color:{{ c }}"></i>
        </div>
        <div>
            <div class="pg-title">{{ editeur.nom }}</div>
            <div class="pg-sub">{{ editeur.iAs|length }} modèle{{ editeur.iAs|length > 1 ? 's' : '' }} IA</div>
        </div>
    </div>
    <a href="{{ path('app_editeur_edit', {'id': editeur.id}) }}" class="btn-primary">
        <i class="ti ti-pencil" style="font-size:13px"></i> Modifier
    </a>
</div>

<div style="display:grid;grid-template-columns:1fr 320px;gap:16px" class="anim anim-1">

    <div class="card">
        <div class="card-head">
            <div class="card-title"><i class="ti ti-robot" style="font-size:15px;color:#a09aff"></i> Modèles IA publiés</div>
        </div>
        {% for ia in editeur.iAs %}
        <div class="list-row">
            <div class="ava ava-purple">{{ ia.nom|slice(0,1)|upper }}</div>
            <div style="flex:1">
                <div style="font-size:13px;font-weight:500;color:var(--t1)">{{ ia.nom }}</div>
                <div style="font-size:11px;color:var(--t3)">{{ ia.versions|length }} version{{ ia.versions|length > 1 ? 's' : '' }}</div>
            </div>
            <a href="{{ path('app_ia_show', {'id': ia.id}) }}" class="card-link">
                Voir <i class="ti ti-arrow-right" style="font-size:11px"></i>
            </a>
        </div>
        {% else %}
        <div style="padding:2.5rem;text-align:center;color:var(--t3)">
            <i class="ti ti-robot-off" style="font-size:22px;display:block;margin-bottom:6px"></i>
            Aucun modèle IA publié par cet éditeur
        </div>
        {% endfor %}
    </div>

    <div style="display:flex;flex-direction:column;gap:14px">

        <div class="card">
            <div class="card-head">
                <div class="card-title"><i class="ti ti-info-circle" style="font-size:15px;color:var(--t3)"></i> Informations</div>
            </div>
            <div style="padding:1rem">
                <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)">
                    <span style="font-size:12px;color:var(--t3)">ID</span>
                    <span style="font-size:12px;font-family:monospace;color:var(--t2)">#{{ editeur.id }}</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0">
                    <span style="font-size:12px;color:var(--t3)">Modèles IA</span>
                    <span style="font-size:12px;color:var(--t2)">{{ editeur.iAs|length }}</span>
                </div>
            </div>
        </div>

        <div class="card" style="border-color:rgba(255,71,87,.15)">
            <div class="card-head" style="border-color:rgba(255,71,87,.1)">
                <div class="card-title" style="color:var(--red)"><i class="ti ti-trash" style="font-size:15px"></i> Zone dangereuse</div>
            </div>
            <div style="padding:1rem">
                <p style="font-size:12px;color:var(--t3);margin-bottom:10px">La suppression est irréversible.</p>
                <form method="post" action="{{ path('app_editeur_delete', {'id': editeur.id}) }}"
                      onsubmit="return confirm('Confirmer la suppression de {{ editeur.nom }} ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ editeur.id) }}">
                    <button type="submit"
                            style="width:100%;padding:8px;border-radius:var(--r8);background:var(--red-bg);color:var(--red);border:1px solid rgba(255,71,87,.25);font-size:13px;font-weight:500;cursor:pointer;font-family:inherit;transition:background .15s"
                            onmouseover="this.style.background='rgba(255,71,87,.2)'" onmouseout="this.style.background='var(--red-bg)'">
                        <i class="ti ti-trash" style="font-size:13px;margin-right:5px"></i>Supprimer l'éditeur
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

{% endblock %}