{% extends 'base.html.twig' %}

{% block title %}Ingenieur index{% endblock %}

{% block body %}
    <h1>Ingenieur index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ingenieur in ingenieurs %}
            <tr>
                <td>{{ ingenieur.id }}</td>
                <td>{{ ingenieur.nom }}</td>
                <td>{{ ingenieur.prenom }}</td>
                <td>
                    <a href="{{ path('app_ingenieur_show', {'id': ingenieur.id}) }}">show</a>
                    <a href="{{ path('app_ingenieur_edit', {'id': ingenieur.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ingenieur_new') }}">Create new</a>
{% endblock %}
