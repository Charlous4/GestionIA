<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}AI Incident Manager{% endblock %}</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🛡️</text></svg>">

    {# Tabler Icons #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.x/tabler-icons.min.css">

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg-primary:    #ffffff;
            --bg-secondary:  #f5f5f3;
            --bg-tertiary:   #eeede9;
            --text-primary:  #1a1a18;
            --text-secondary:#5f5e5a;
            --text-muted:    #888780;
            --border:        rgba(0,0,0,0.1);
            --radius-md:     8px;
            --radius-lg:     12px;
            --danger:        #a32d2d;
            --danger-bg:     #fcebeb;
            --warning:       #854f0b;
            --warning-bg:    #faeeda;
            --success:       #3b6d11;
            --success-bg:    #eaf3de;
            --info:          #185fa5;
            --info-bg:       #e6f1fb;
        }

        body {
            font-family: system-ui, -apple-system, sans-serif;
            background: var(--bg-tertiary);
            color: var(--text-primary);
            font-size: 15px;
            line-height: 1.6;
        }

        /* ── Navbar ── */
        .navbar {
            position: sticky; top: 0; z-index: 100;
            height: 56px;
            background: var(--bg-primary);
            border-bottom: 0.5px solid var(--border);
            padding: 0 1.5rem;
            display: flex; align-items: center; justify-content: space-between;
        }
        .navbar-brand {
            display: flex; align-items: center; gap: 10px;
            font-size: 16px; font-weight: 500; text-decoration: none;
            color: var(--text-primary);
        }
        .brand-icon {
            width: 32px; height: 32px; border-radius: var(--radius-md);
            background: #2c2c2a; color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px;
        }
        .navbar-right { display: flex; align-items: center; gap: 8px; }
        .badge-notif {
            background: var(--danger-bg); color: var(--danger);
            font-size: 11px; font-weight: 500;
            padding: 2px 7px; border-radius: 999px;
        }
        .nav-avatar {
            width: 32px; height: 32px; border-radius: 50%;
            background: var(--info-bg); color: var(--info);
            display: flex; align-items: center; justify-content: center;
            font-size: 12px; font-weight: 500;
        }
        .icon-btn {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 10px; border-radius: var(--radius-md);
            border: 0.5px solid var(--border);
            background: transparent; color: var(--text-secondary);
            cursor: pointer; font-size: 13px;
        }
        .icon-btn:hover { background: var(--bg-secondary); }

        /* ── Layout ── */
        .app-layout {
            display: flex;
            min-height: calc(100vh - 56px);
        }

        /* ── Sidebar ── */
        .sidebar {
            width: 220px; flex-shrink: 0;
            background: var(--bg-primary);
            border-right: 0.5px solid var(--border);
            padding: 1rem 0;
            position: sticky; top: 56px;
            height: calc(100vh - 56px);
            overflow-y: auto;
        }
        .sidebar-section { padding: 0 0.75rem; margin-bottom: 1.5rem; }
        .sidebar-label {
            font-size: 11px; font-weight: 500;
            color: var(--text-muted);
            text-transform: uppercase; letter-spacing: .06em;
            padding: 0 0.5rem; margin-bottom: 6px;
        }
        .sidebar-item {
            display: flex; align-items: center; gap: 10px;
            padding: 8px 10px;
            border-radius: var(--radius-md);
            font-size: 14px; color: var(--text-secondary);
            text-decoration: none;
            transition: background .12s;
        }
        .sidebar-item:hover { background: var(--bg-secondary); }
        .sidebar-item.active {
            background: var(--bg-secondary);
            color: var(--text-primary); font-weight: 500;
        }
        .sidebar-item i { font-size: 16px; }
        .sidebar-count {
            margin-left: auto; font-size: 11px; font-weight: 500;
            background: var(--danger-bg); color: var(--danger);
            padding: 1px 6px; border-radius: 999px;
        }

        /* ── Main content ── */
        .main-content { flex: 1; padding: 1.5rem; overflow-y: auto; }

        .page-header {
            display: flex; align-items: flex-start; justify-content: space-between;
            margin-bottom: 1.5rem;
        }
        .page-title { font-size: 22px; font-weight: 500; }
        .page-subtitle { font-size: 14px; color: var(--text-secondary); margin-top: 2px; }

        /* ── Buttons ── */
        .btn-primary {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 8px 16px;
            background: var(--text-primary); color: var(--bg-primary);
            border: none; border-radius: var(--radius-md);
            font-size: 14px; font-weight: 500; cursor: pointer;
            text-decoration: none;
        }
        .btn-primary:hover { opacity: 0.88; }

        /* ── Stat cards ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 12px;
            margin-bottom: 1.5rem;
        }
        .stat-card {
            background: var(--bg-secondary);
            border-radius: var(--radius-md);
            padding: 1rem;
        }
        .stat-label { font-size: 12px; color: var(--text-secondary); margin-bottom: 6px; }
        .stat-value { font-size: 24px; font-weight: 500; }
        .stat-value.danger  { color: var(--danger); }
        .stat-value.warning { color: var(--warning); }
        .stat-value.success { color: var(--success); }

        /* ── Severity badges ── */
        .severity {
            display: inline-flex; align-items: center;
            font-size: 11px; font-weight: 500;
            padding: 3px 8px; border-radius: 999px;
        }
        .sev-critical { background: var(--danger-bg);  color: var(--danger); }
        .sev-high     { background: var(--warning-bg); color: var(--warning); }
        .sev-medium   { background: var(--info-bg);    color: var(--info); }
        .sev-low      { background: var(--success-bg); color: var(--success); }

        /* ── Status dot ── */
        .status-dot { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; }
        .dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
        .dot-open     { background: var(--danger); }
        .dot-progress { background: var(--warning); }
        .dot-resolved { background: var(--success); }

        /* ── Table card ── */
        .table-card {
            background: var(--bg-primary);
            border: 0.5px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }
        .table-toolbar {
            display: flex; align-items: center; gap: 8px;
            padding: 12px 16px;
            border-bottom: 0.5px solid var(--border);
        }
        .table-toolbar input {
            flex: 1; font-size: 14px;
            padding: 6px 10px;
            border: 0.5px solid var(--border);
            border-radius: var(--radius-md);
            background: var(--bg-secondary);
            color: var(--text-primary);
        }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th {
            padding: 10px 16px; text-align: left;
            font-size: 11px; font-weight: 500;
            color: var(--text-muted);
            text-transform: uppercase; letter-spacing: .05em;
            border-bottom: 0.5px solid var(--border);
        }
        td {
            padding: 12px 16px;
            border-bottom: 0.5px solid var(--border);
            color: var(--text-secondary);
        }
        tr:last-child td { border-bottom: none; }
        tbody tr:hover td { background: var(--bg-secondary); }

        /* ── Flash messages ── */
        .flash { padding: 10px 16px; border-radius: var(--radius-md); margin-bottom: 1rem; font-size: 14px; }
        .flash-success { background: var(--success-bg); color: var(--success); }
        .flash-danger  { background: var(--danger-bg);  color: var(--danger); }
        .flash-info    { background: var(--info-bg);    color: var(--info); }
    </style>

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>
<body>

<nav class="navbar">
    <a href="{{ path('app_home') }}" class="navbar-brand">
        <div class="brand-icon"><i class="ti ti-shield-bolt"></i></div>
        AI Incident Manager
    </a>
    <div class="navbar-right">
        <button class="icon-btn">
            <i class="ti ti-bell"></i>
            <span class="badge-notif">{{ notifications_count ?? 0 }}</span>
        </button>
        <div class="nav-avatar">
            {{ app.user ? app.user.email[0]|upper ~ (app.user.email[1]|upper) : 'AI' }}
        </div>
    </div>
</nav>

<div class="app-layout">

    <aside class="sidebar">
        <div class="sidebar-section">
            <div class="sidebar-label">Tableau de bord</div>
            <a href="{{ path('app_home') }}" class="sidebar-item {{ app.current_route == 'app_home' ? 'active' }}">
                <i class="ti ti-layout-dashboard"></i> Vue d'ensemble
            </a>
            <a href="{{ path('app_ticket_index') }}" class="sidebar-item {{ app.current_route starts with 'app_incident' ? 'active' }}">
                <i class="ti ti-alert-triangle"></i> Incidents
                {% if open_count is defined and open_count > 0 %}
                    <span class="sidebar-count">{{ open_count }}</span>
                {% endif %}
            </a>

        </div>
        <div class="sidebar-section">
            <div class="sidebar-label">Gestion</div>
            <a href="{{ path('app_ia_index') }}" class="sidebar-item {{ app.current_route starts with 'app_model' ? 'active' }}">
                <i class="ti ti-robot"></i> Modèles IA
            </a>
            <a href="{{ path('app_editeur_index') }}" class="sidebar-item {{ app.current_route starts with 'app_category' ? 'active' }}">
                <i class="ti ti-tag"></i> Catégories
            </a>
        </div>
        <div class="sidebar-section">
            <div class="sidebar-label">Compte</div>
            <a href="#" class="sidebar-item">
                <i class="ti ti-settings"></i> Paramètres
            </a>
            {% if app.user %}
            <a href="{{ path('app_logout') }}" class="sidebar-item">
                <i class="ti ti-logout"></i> Déconnexion
            </a>
            {% endif %}
        </div>
    </aside>

    <main class="main-content">

        {# Flash messages #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}

    </main>

</div>

</body>
</html>