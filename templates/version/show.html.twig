{% extends 'base.html.twig' %}
{% block title %}{{ version.nom }}{% endblock %}

{% block body %}

<div class="pg-header anim">
    <div style="display:flex;align-items:center;gap:12px">
        <a href="{{ path('app_version_index') }}"
           style="width:34px;height:34px;border-radius:var(--r8);background:var(--bg-2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--t2);text-decoration:none;transition:color .15s"
           onmouseover="this.style.color='var(--t1)'" onmouseout="this.style.color='var(--t2)'">
            <i class="ti ti-arrow-left" style="font-size:15px"></i>
        </a>
        <div>
            <div class="pg-title" style="display:flex;align-items:center;gap:10px">
                {{ version.nom }}
                {% if version.statut == 'ok' %}
                    <span class="badge badge-green">Fonctionnel</span>
                {% elseif version.statut == 'mid' %}
                    <span class="badge badge-amber">En étude</span>
                {% elseif version.statut == 'pas_ok' %}
                    <span class="badge badge-red">Défaillante</span>
                {% else %}
                    <span class="badge badge-blue">{{ version.statut }}</span>
                {% endif %}
            </div>
            <div class="pg-sub">{{ version.ia ? version.ia.nom : 'Modèle inconnu' }}</div>
        </div>
    </div>
    <a href="{{ path('app_version_edit', {'id': version.id}) }}" class="btn-primary">
        <i class="ti ti-pencil" style="font-size:13px"></i> Modifier
    </a>
</div>

<div style="display:grid;grid-template-columns:1fr 320px;gap:16px" class="anim anim-1">

    <div class="card">
        <div class="card-head">
            <div class="card-title"><i class="ti ti-alert-triangle" style="font-size:15px;color:var(--red)"></i> Tickets liés</div>
        </div>
        {% for ticket in version.tickets %}
        <div class="list-row">
            <div class="dot {{ ticket.priorite ? 'dot-red' : 'dot-green' }}"></div>
            <div style="flex:1;min-width:0">
                <div style="font-size:13px;font-weight:500;color:var(--t1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                    {{ ticket.description }}
                </div>
                <div style="font-size:11px;color:var(--t3)">
                    {% if ticket.ingenieur %}{{ ticket.ingenieur.prenom }} {{ ticket.ingenieur.nom }}{% else %}Non assigné{% endif %}
                </div>
            </div>
            {% if ticket.priorite %}
                <span class="badge badge-red">Urgent</span>
            {% else %}
                <span class="badge badge-green">Normal</span>
            {% endif %}
        </div>
        {% else %}
        <div style="padding:2.5rem;text-align:center;color:var(--t3)">
            <i class="ti ti-mood-smile" style="font-size:22px;display:block;margin-bottom:6px"></i>
            Aucun ticket lié à cette version
        </div>
        {% endfor %}
    </div>

    <div style="display:flex;flex-direction:column;gap:14px">

        <div class="card">
            <div class="card-head">
                <div class="card-title"><i class="ti ti-info-circle" style="font-size:15px;color:var(--t3)"></i> Informations</div>
            </div>
            <div style="padding:1rem">
                <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)">
                    <span style="font-size:12px;color:var(--t3)">ID</span>
                    <span style="font-size:12px;font-family:monospace;color:var(--t2)">#{{ version.id }}</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)">
                    <span style="font-size:12px;color:var(--t3)">Modèle IA</span>
                    <span style="font-size:12px;color:var(--t2)">{{ version.ia ? version.ia.nom : '—' }}</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0">
                    <span style="font-size:12px;color:var(--t3)">Statut brut</span>
                    <span style="font-size:12px;color:var(--t2);font-family:monospace">{{ version.statut }}</span>
                </div>
            </div>
        </div>

        <div class="card" style="border-color:rgba(255,71,87,.15)">
            <div class="card-head" style="border-color:rgba(255,71,87,.1)">
                <div class="card-title" style="color:var(--red)"><i class="ti ti-trash" style="font-size:15px"></i> Zone dangereuse</div>
            </div>
            <div style="padding:1rem">
                <p style="font-size:12px;color:var(--t3);margin-bottom:10px">La suppression est irréversible.</p>
                <form method="post" action="{{ path('app_version_delete', {'id': version.id}) }}"
                      onsubmit="return confirm('Confirmer la suppression de {{ version.nom }} ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ version.id) }}">
                    <button type="submit"
                            style="width:100%;padding:8px;border-radius:var(--r8);background:var(--red-bg);color:var(--red);border:1px solid rgba(255,71,87,.25);font-size:13px;font-weight:500;cursor:pointer;font-family:inherit;transition:background .15s"
                            onmouseover="this.style.background='rgba(255,71,87,.2)'" onmouseout="this.style.background='var(--red-bg)'">
                        <i class="ti ti-trash" style="font-size:13px;margin-right:5px"></i>Supprimer cette version
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

{% endblock %}