{% extends 'base.html.twig' %}

{% block title %}Version index{% endblock %}

{% block body %}
    <h1>Version index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Statut</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for version in versions %}
            <tr>
                <td>{{ version.id }}</td>
                <td>{{ version.nom }}</td>
                <td>
                    {% if version.statut == 'ok' %}
                        <span class="severity sev-low">Fonctionnel</span>
                    {% elseif version.statut == 'mid' %}
                        <span class="severity sev-high">En Étude</span>
                    {% elseif version.statut == 'pas_ok' %}
                        <span class="severity sev-critical">Défaillante</span>
                    {% else %}
                        <span class="severity">{{ version.statut }}</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_version_show', {'id': version.id}) }}">show</a>
                    <a href="{{ path('app_version_edit', {'id': version.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_version_new') }}">Create new</a>
{% endblock %}
