{% extends 'base.html.twig' %}
{% block title %}Versions{% endblock %}

{% block body %}

<div class="pg-header anim">
    <div>
        <div class="pg-title">Versions</div>
        <div class="pg-sub">{{ versions|length }} version{{ versions|length > 1 ? 's' : '' }} enregistrée{{ versions|length > 1 ? 's' : '' }}</div>
    </div>
    <a href="{{ path('app_version_new') }}" class="btn-primary">
        <i class="ti ti-plus" style="font-size:14px"></i> Nouvelle version
    </a>
</div>

<div class="table-card anim anim-1">
    <div class="table-toolbar">
        <i class="ti ti-search" style="color:var(--t3);font-size:15px"></i>
        <input type="text" placeholder="Rechercher une version…" id="search-input">
    </div>

    <table>
        <thead>
            <tr>
                <th style="width:60px">#</th>
                <th>Nom</th>
                <th>Modèle IA</th>
                <th>Statut</th>
                <th>Tickets</th>
                <th style="width:100px">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for version in versions %}
            <tr class="version-row">
                <td><span style="font-size:11px;color:var(--t3);font-family:monospace">#{{ version.id }}</span></td>
                <td>
                    <span style="color:var(--t1);font-weight:500">{{ version.nom }}</span>
                </td>
                <td>
                    {% if version.ia %}
                    <div style="display:flex;align-items:center;gap:8px">
                        <div class="ava ava-purple" style="width:24px;height:24px;font-size:10px">
                            {{ version.ia.nom|slice(0,1)|upper }}
                        </div>
                        <span style="color:var(--t2)">{{ version.ia.nom }}</span>
                    </div>
                    {% else %}
                    <span style="color:var(--t3)">—</span>
                    {% endif %}
                </td>
                <td>
                    {% if version.statut == 'ok' %}
                        <span class="badge badge-green"><span class="dot dot-green" style="width:5px;height:5px;margin-right:4px"></span>Fonctionnel</span>
                    {% elseif version.statut == 'mid' %}
                        <span class="badge badge-amber"><span class="dot dot-amber" style="width:5px;height:5px;margin-right:4px"></span>En étude</span>
                    {% elseif version.statut == 'pas_ok' %}
                        <span class="badge badge-red"><span class="dot dot-red" style="width:5px;height:5px;margin-right:4px"></span>Défaillante</span>
                    {% else %}
                        <span class="badge badge-blue">{{ version.statut }}</span>
                    {% endif %}
                </td>
                <td>
                    {% set n = version.tickets|length %}
                    <span style="font-size:12px;color:{{ n > 0 ? 'var(--red)' : 'var(--t3)' }}">
                        {{ n }} ticket{{ n > 1 ? 's' : '' }}
                    </span>
                </td>
                <td>
                    <div style="display:flex;align-items:center;gap:6px">
                        <a href="{{ path('app_version_show', {'id': version.id}) }}"
                           class="row-icon-btn" title="Voir">
                            <i class="ti ti-eye" style="font-size:13px"></i>
                        </a>
                        <a href="{{ path('app_version_edit', {'id': version.id}) }}"
                           class="row-icon-btn row-icon-edit" title="Modifier">
                            <i class="ti ti-pencil" style="font-size:13px"></i>
                        </a>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" style="text-align:center;padding:3rem;color:var(--t3)">
                    <i class="ti ti-versions" style="font-size:28px;display:block;margin-bottom:8px"></i>
                    Aucune version trouvée
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<style>
.row-icon-btn {
    width:28px;height:28px;border-radius:var(--r8);background:var(--bg-3);
    border:1px solid var(--border);display:flex;align-items:center;justify-content:center;
    color:var(--t2);text-decoration:none;transition:all .15s;
}
.row-icon-btn:hover { color:var(--blue); border-color:rgba(56,189,248,.3); background:var(--blue-bg); }
.row-icon-edit:hover { color:#a09aff; border-color:rgba(108,99,255,.3); background:rgba(108,99,255,.1); }
</style>

<script>
document.getElementById('search-input').addEventListener('input', function() {
    const q = this.value.toLowerCase();
    document.querySelectorAll('.version-row').forEach(function(row) {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
});
</script>

{% endblock %}