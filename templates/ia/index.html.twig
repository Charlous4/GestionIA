{% extends 'base.html.twig' %}

{% block title %}IA index{% endblock %}

{% block body %}
    <h1>IA index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ium in ias %}
            <tr>
                <td>{{ ium.id }}</td>
                <td>{{ ium.nom }}</td>
                <td>
                    <a href="{{ path('app_ia_show', {'id': ium.id}) }}">show</a>
                    <a href="{{ path('app_ia_edit', {'id': ium.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ia_new') }}">Create new</a>
{% endblock %}
