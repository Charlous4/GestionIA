{% extends 'base.html.twig' %}
{% block title %}Modèles IA{% endblock %}

{% block body %}

<div class="pg-header anim">
    <div>
        <div class="pg-title">Modèles IA</div>
        <div class="pg-sub">{{ ias|length }} modèle{{ ias|length > 1 ? 's' : '' }} enregistré{{ ias|length > 1 ? 's' : '' }}</div>
    </div>
    <a href="{{ path('app_ia_new') }}" class="btn-primary">
        <i class="ti ti-plus" style="font-size:14px"></i> Nouveau modèle
    </a>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px" class="anim anim-1">
    {% for ium in ias %}
    {% set colors = ['#6c63ff', '#38bdf8', '#10b981', '#f59e0b', '#ec4899', '#a09aff'] %}
    {% set c = colors[ium.id % 6] %}
    <div class="card" style="display:flex;flex-direction:column">
        <div style="padding:1.25rem;display:flex;align-items:flex-start;gap:12px;border-bottom:1px solid var(--border)">
            <div style="width:44px;height:44px;border-radius:var(--r12);background:{{ c }}22;border:1px solid {{ c }}40;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                <i class="ti ti-robot-face" style="font-size:21px;color:{{ c }}"></i>
            </div>
            <div style="flex:1;min-width:0">
                <div style="font-size:14.5px;font-weight:600;color:var(--t1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                    {{ ium.nom }}
                </div>
                <div style="font-size:11.5px;color:var(--t3);margin-top:2px;display:flex;align-items:center;gap:4px">
                    <i class="ti ti-building" style="font-size:12px"></i>
                    {{ ium.editeur ? ium.editeur.nom : 'Éditeur inconnu' }}
                </div>
            </div>
        </div>
        <div style="padding:0.9rem 1.25rem;display:flex;gap:16px;flex:1">
            <div>
                <div style="font-size:18px;font-weight:600;color:var(--t1)">{{ ium.versions|length }}</div>
                <div style="font-size:10.5px;color:var(--t3);text-transform:uppercase;letter-spacing:.05em">Version{{ ium.versions|length > 1 ? 's' : '' }}</div>
            </div>
            <div style="width:1px;background:var(--border)"></div>
            <div>
                {% set nb_tickets_model = 0 %}
                {% for v in ium.versions %}
                    {% set nb_tickets_model = nb_tickets_model + v.tickets|length %}
                {% endfor %}

                <div style="font-size:18px;font-weight:600;color:{{ nb_tickets_model > 0 ? 'var(--red)' : 'var(--t1)' }}">
                    {{ nb_tickets_model }}
                </div>
                <div style="font-size:10.5px;color:var(--t3);text-transform:uppercase;letter-spacing:.05em">
                    Ticket{{ nb_tickets_model > 1 ? 's' : '' }}
                </div>
            </div>
        </div>
        <div style="padding:10px 12px;border-top:1px solid var(--border);display:flex;gap:8px">
            <a href="{{ path('app_ia_show', {'id': ium.id}) }}"
               style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:7px;border-radius:var(--r8);background:var(--bg-3);border:1px solid var(--border);color:var(--t2);text-decoration:none;font-size:12.5px;transition:all .15s">
                <i class="ti ti-eye" style="font-size:14px"></i> Voir
            </a>
            <a href="{{ path('app_ia_edit', {'id': ium.id}) }}"
               style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:7px;border-radius:var(--r8);background:var(--bg-3);border:1px solid var(--border);color:var(--t2);text-decoration:none;font-size:12.5px;transition:all .15s">
                <i class="ti ti-pencil" style="font-size:14px"></i> Modifier
            </a>
        </div>
    </div>
    {% else %}
    <div class="card" style="grid-column:1/-1;padding:3rem;text-align:center;color:var(--t3)">
        <i class="ti ti-robot-off" style="font-size:28px;display:block;margin-bottom:8px"></i>
        Aucun modèle IA enregistré
    </div>
    {% endfor %}
</div>

<style>
.card a[href*="ia_show"]:hover { border-color: rgba(56,189,248,.3) !important; color: var(--blue) !important; background: var(--blue-bg) !important; }
.card a[href*="ia_edit"]:hover { border-color: rgba(108,99,255,.3) !important; color: #a09aff !important; background: rgba(108,99,255,.1) !important; }
</style>

{% endblock %}