{% extends 'base.html.twig' %}

{% block title %}Ticket index{% endblock %}

{% block body %}
    <h1>Ticket d'incident</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Numéro</th>
                <th>IA</th>
                <th>Version</th>
                <th>Description</th>
                <th> Occupé par </th>
                <th>Priorite</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ticket in tickets %}
            <tr>
                <td>{{ ticket.id }}</td>

                <td>{{ ticket.version.ia.nom }} </td>

                <td>{{ ticket.version ? ticket.version.nom : 'Non assigné' }}</td>

                <td>{{ ticket.description }}</td>
                
                <td>
                    {% if ticket.ingenieur %}
                        {{ ticket.ingenieur.nom|upper }} {{ ticket.ingenieur.prenom }}
                    {% else %}
                        <span class="text-muted">Non assigné</span>
                    {% endif %}
                </td>
                
                <td>{{ ticket.priorite ? 'Oui' : 'Non' }}</td>
                
                <td>
                    <a href="{{ path('app_ticket_show', {'id': ticket.id}) }}">show</a>
                    <a href="{{ path('app_ticket_edit', {'id': ticket.id}) }}">edit</a>
                
                </td>
            
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ticket_new') }}">Create new</a>
{% endblock %}
