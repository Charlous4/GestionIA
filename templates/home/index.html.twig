{% extends 'base.html.twig' %}
{% block title %}Vue d'ensemble — AI Incident Manager{% endblock %}

{% block body %}

<div class="pg-header anim">
    <div>
        <div class="pg-title">Vue d'ensemble</div>
        <div class="pg-sub">{{ "now"|date("d/m/Y · H:i") }} &mdash; Tableau de bord en temps réel</div>
    </div>
    <div style="display:flex;gap:8px">
        <a href="{{ path('app_ticket_new') }}" class="btn-primary">
            <i class="ti ti-plus" style="font-size:14px"></i> Nouveau ticket
        </a>
        <a href="http://localhost/adminer.php" target="_blank" class="btn-ghost">
            <i class="ti ti-database" style="font-size:14px"></i> Base de données
        </a>
    </div>
</div>

{# ── Stats ── #}
<div class="stats-grid anim anim-1">
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(255,71,87,.12);color:var(--red)">
            <i class="ti ti-alert-circle"></i>
        </div>
        <div class="stat-label">Prioritaires</div>
        <div class="stat-val red">{{ tickets_prioritaires }}</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(16,185,129,.12);color:var(--green)">
            <i class="ti ti-circle-check"></i>
        </div>
        <div class="stat-label">Normaux</div>
        <div class="stat-val green">{{ tickets_normaux }}</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(108,99,255,.12);color:#a09aff">
            <i class="ti ti-robot"></i>
        </div>
        <div class="stat-label">Modèles IA</div>
        <div class="stat-val purple">{{ nb_ia }}</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(56,189,248,.12);color:var(--blue)">
            <i class="ti ti-building"></i>
        </div>
        <div class="stat-label">Éditeurs</div>
        <div class="stat-val blue">{{ nb_editeurs }}</div>
    </div>
</div>

{# ── Grille principale ── #}
<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px" class="anim anim-2">

    {# Tickets récents #}
    <div class="card">
        <div class="card-head">
            <div class="card-title">
                <i class="ti ti-alert-triangle" style="color:var(--red);font-size:15px"></i>
                Tickets récents
            </div>
            <a href="{{ path('app_ticket_index') }}" class="card-link">
                Voir tout <i class="ti ti-arrow-right" style="font-size:12px"></i>
            </a>
        </div>
        {% for ticket in tickets_recents %}
        <div class="list-row">
            <div class="dot {{ ticket.priorite ? 'dot-red' : 'dot-green' }}"></div>
            <div style="flex:1;min-width:0">
                <div style="font-size:13px;font-weight:500;color:var(--t1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                    {{ ticket.description }}
                </div>
                <div style="font-size:11px;color:var(--t3);margin-top:1px">
                    {% if ticket.version %}{{ ticket.version.nom }}{% else %}—{% endif %}
                    {% if ticket.ingenieur %} · {{ ticket.ingenieur.prenom }} {{ ticket.ingenieur.nom }}{% endif %}
                </div>
            </div>
            {% if ticket.priorite %}
                <span class="badge badge-red">Urgent</span>
            {% else %}
                <span class="badge badge-green">Normal</span>
            {% endif %}
        </div>
        {% else %}
        <div style="padding:2.5rem;text-align:center;color:var(--t3)">
            <i class="ti ti-mood-smile" style="font-size:22px;display:block;margin-bottom:6px"></i>
            Aucun ticket
        </div>
        {% endfor %}
    </div>

    {# Modèles IA #}
    <div class="card">
        <div class="card-head">
            <div class="card-title">
                <i class="ti ti-robot" style="color:#a09aff;font-size:15px"></i>
                Modèles IA
            </div>
            <a href="{{ path('app_ia_index') }}" class="card-link">
                Gérer <i class="ti ti-arrow-right" style="font-size:12px"></i>
            </a>
        </div>
        {% for ia in ias %}
        <div class="list-row">
            <div class="ava ava-purple">{{ ia.nom|slice(0,1)|upper }}</div>
            <div style="flex:1">
                <div style="font-size:13px;font-weight:500;color:var(--t1)">{{ ia.nom }}</div>
                <div style="font-size:11px;color:var(--t3)">{{ ia.editeur ? ia.editeur.nom : 'Éditeur inconnu' }}</div>
            </div>
            <div style="text-align:right">
                <div style="font-size:12px;color:var(--t2)">{{ ia.versions|length }} ver.</div>
                {% set nb_tickets_ia = 0 %}

                {# 2. On additionne le nombre de tickets de chaque version #}
                {% for v in ia.versions %}
                    {% set nb_tickets_ia = nb_tickets_ia + v.tickets|length %}
                {% endfor %}

                {# 3. Si le compteur est supérieur à 0, on affiche le badge #}
                {% if nb_tickets_ia > 0 %}
                    <span class="badge badge-red" style="font-size:9px">
                        {{ nb_tickets_ia }} ticket{{ nb_tickets_ia > 1 ? 's' : '' }}
                    </span>
                {% endif %}
            </div>
        </div>
        {% else %}
        <div style="padding:2.5rem;text-align:center;color:var(--t3)">Aucun modèle IA</div>
        {% endfor %}
    </div>

</div>

{# ── Deuxième grille ── #}
<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px" class="anim anim-3">

    {# Versions #}
    <div class="card">
        <div class="card-head">
            <div class="card-title">
                <i class="ti ti-versions" style="color:var(--blue);font-size:15px"></i>
                Versions
            </div>
            <a href="{{ path('app_version_index') }}" class="card-link">
                Voir tout <i class="ti ti-arrow-right" style="font-size:12px"></i>
            </a>
        </div>
        {% for version in versions_recentes %}
        <div class="list-row">
            <div style="flex:1">
                <div style="font-size:13px;font-weight:500;color:var(--t1)">{{ version.nom }}</div>
                <div style="font-size:11px;color:var(--t3)">
                    {{ version.ia ? version.ia.nom : '—' }}
                    · {{ version.tickets|length }} ticket{{ version.tickets|length > 1 ? 's' : '' }}
                </div>
            </div>
            {% if version.statut == 'ok' %}
                <span class="badge badge-green">Fonctionnel</span>
            {% elseif version.statut == 'mid' %}
                <span class="badge badge-amber">En étude</span>
            {% elseif version.statut == 'pas_ok' %}
                <span class="badge badge-red">Défaillante</span>
            {% else %}
                <span class="badge badge-blue">{{ version.statut }}</span>
            {% endif %}
        </div>
        {% else %}
        <div style="padding:2.5rem;text-align:center;color:var(--t3)">Aucune version</div>
        {% endfor %}
    </div>

    {# Ingénieurs #}
    <div class="card">
        <div class="card-head">
            <div class="card-title">
                <i class="ti ti-users" style="color:var(--green);font-size:15px"></i>
                Ingénieurs
            </div>
            <a href="{{ path('app_ingenieur_index') }}" class="card-link">
                Voir tout <i class="ti ti-arrow-right" style="font-size:12px"></i>
            </a>
        </div>
        {% for ing in ingenieurs %}
        <div class="list-row">
            <div class="ava ava-blue ava-circle">
                {{ ing.prenom|slice(0,1)|upper }}{{ ing.nom|slice(0,1)|upper }}
            </div>
            <div style="flex:1">
                <div style="font-size:13px;font-weight:500;color:var(--t1)">{{ ing.prenom }} {{ ing.nom }}</div>
                <div style="font-size:11px;color:var(--t3)">
                    {{ ing.tickets|length }} ticket{{ ing.tickets|length > 1 ? 's' : '' }} assigné{{ ing.tickets|length > 1 ? 's' : '' }}
                </div>
            </div>
            {% if tickets_total > 0 and ing.tickets|length > 0 %}
            <div style="width:50px">
                <div style="height:3px;background:var(--bg-4);border-radius:99px;overflow:hidden">
                    {% set pct = ((ing.tickets|length / tickets_total) * 100)|round %}
                    <div style="height:100%;width:{{ pct > 100 ? 100 : pct }}%;background:linear-gradient(90deg,#6c63ff,#38bdf8);border-radius:99px"></div>
                </div>
                <div style="font-size:10px;color:var(--t3);text-align:right;margin-top:3px">{{ pct }}%</div>
            </div>
            {% endif %}
        </div>
        {% else %}
        <div style="padding:2.5rem;text-align:center;color:var(--t3)">Aucun ingénieur</div>
        {% endfor %}
    </div>

</div>

{% endblock %}